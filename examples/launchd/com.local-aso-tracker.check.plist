<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.local-aso-tracker.check</string>
  <key>ProgramArguments</key><array>
    <string>/absolute/path/to/local-aso-tracker/.venv/bin/aso</string>
    <string>check</string><string>--only-missing-today</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/local-aso-tracker.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/local-aso-tracker.err.log</string>
</dict></plist>
